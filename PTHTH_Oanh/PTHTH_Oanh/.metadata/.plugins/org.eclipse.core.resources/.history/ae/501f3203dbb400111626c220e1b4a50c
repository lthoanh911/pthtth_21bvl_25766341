import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;

public class InventoryManager {
    private static final Path CSV_PATH = Path.of("data", "inventory.csv");
    private static final Path REPORT_PATH = Path.of("data", "inventory-report.txt");

    public static void main(String[] args) {
        BufferedReader console = new BufferedReader(new InputStreamReader(System.in, StandardCharsets.UTF_8));
        List<Product> inputList = new ArrayList<>();

        System.out.println("=== 1. NHẬP DANH SÁCH SẢN PHẨM TỪ BÀN PHÍM ===");
        while (true) {
            try {
                System.out.print("Nhập mã sản phẩm (nhập 'exit' hoặc để trống để dừng): ");
                String code = console.readLine();
                if (code == null || code.isBlank() || code.equalsIgnoreCase("exit")) {
                    break;
                }

                System.out.print("Nhập tên sản phẩm: ");
                String name = console.readLine();

                System.out.print("Nhập đơn giá (> 0): ");
                double price = Double.parseDouble(console.readLine().trim());

                System.out.print("Nhập số lượng (>= 0): ");
                int qty = Integer.parseInt(console.readLine().trim());

                Product p = new Product(code, name, price, qty);
                inputList.add(p);
                System.out.println("=> Đã thêm sản phẩm thành công.\n");
            } catch (NumberFormatException e) {
                System.err.println("Lỗi: Đơn giá hoặc số lượng phải là số hợp lệ!\n");
            } catch (IllegalArgumentException e) {
                System.err.println("Lỗi dữ liệu: " + e.getMessage() + "\n");
            } catch (IOException e) {
                System.err.println("Lỗi nhập liệu từ console: " + e.getMessage() + "\n");
            }
        }

        // 2. Ghi danh sách ra data/inventory.csv
        saveToCsv(inputList, CSV_PATH);

        // 3. Đọc lại từ tệp CSV
        List<Product> loadedProducts = readFromCsv(CSV_PATH);

        // 4. Hiển thị danh sách, tính tổng giá trị & tìm sản phẩm có giá trị tồn cao nhất
        displayAndGenerateReport(loadedProducts, REPORT_PATH);
    }

    private static void saveToCsv(List<Product> list, Path path) {
        try {
            if (path.getParent() != null) {
                Files.createDirectories(path.getParent());
            }
            try (BufferedWriter writer = Files.newBufferedWriter(path, StandardCharsets.UTF_8)) {
                writer.write("ma,ten,donGia,soLuong");
                writer.newLine();
                for (Product p : list) {
                    writer.write(p.toCsvRow());
                    writer.newLine();
                }
            }
            System.out.println("\n=> Đã lưu thành công " + list.size() + " sản phẩm vào " + path);
        } catch (IOException e) {
            System.err.println("Lỗi ghi tệp CSV [" + path + "]: " + e.getMessage());
        }
    }

    private static List<Product> readFromCsv(Path path) {
        List<Product> list = new ArrayList<>();
        if (!Files.exists(path)) {
            System.err.println("Lỗi: Tệp CSV không tồn tại -> " + path);
            return list;
        }

        try (BufferedReader reader = Files.newBufferedReader(path, StandardCharsets.UTF_8)) {
            String header = reader.readLine(); // Bỏ qua dòng tiêu đề
            String line;
            int lineNumber = 1;

            while ((line = reader.readLine()) != null) {
                lineNumber++;
                if (line.isBlank()) continue;

                String[] parts = line.split(",", -1);
                if (parts.length != 4) {
                    System.err.println("Tệp [" + path + "] - Dòng " + lineNumber + " lỗi cấu trúc (thiếu cột), bỏ qua.");
                    continue;
                }

                try {
                    String code = parts[0].trim();
                    String name = parts[1].trim();
                    double price = Double.parseDouble(parts[2].trim());
                    int qty = Integer.parseInt(parts[3].trim());

                    list.add(new Product(code, name, price, qty));
                } catch (NumberFormatException e) {
                    System.err.println("Tệp [" + path + "] - Dòng " + lineNumber + " lỗi định dạng số: " + e.getMessage());
                } catch (IllegalArgumentException e) {
                    System.err.println("Tệp [" + path + "] - Dòng " + lineNumber + " dữ liệu không hợp lệ: " + e.getMessage());
                }
            }
        } catch (IOException e) {
            System.err.println("Lỗi đọc tệp CSV [" + path + "]: " + e.getMessage());
        }
        return list;
    }

    private static void displayAndGenerateReport(List<Product> list, Path reportPath) {
        System.out.println("\n=== 2. KẾT QUẢ ĐỌC TỪ CSV ===");
        if (list.isEmpty()) {
            System.out.println("Danh sách trống, không có dữ liệu để xuất báo cáo.");
            return;
        }

        double totalValue = 0;
        Product maxValProduct = list.get(0);

        for (Product p : list) {
            System.out.println(p);
            totalValue += p.inventoryValue();
            if (p.inventoryValue() > maxValProduct.inventoryValue()) {
                maxValProduct = p;
            }
        }

        System.out.printf("=> Tổng giá trị tồn kho: %,.0f VND%n", totalValue);
        System.out.printf("=> Sản phẩm có giá trị tồn lớn nhất: %s (%s) - %,.0f VND%n",
                maxValProduct.getName(), maxValProduct.getCode(), maxValProduct.inventoryValue());

        // Ghi ra file data/inventory-report.txt
        try {
            if (reportPath.getParent() != null) {
                Files.createDirectories(reportPath.getParent());
            }
            try (BufferedWriter writer = Files.newBufferedWriter(reportPath, StandardCharsets.UTF_8)) {
                writer.write("BÁO CÁO TỔNG HỢP TỒN KHO");
                writer.newLine();
                writer.write("----------------------------------------");
                writer.newLine();
                writer.write("Tổng số sản phẩm: " + list.size());
                writer.newLine();
                writer.write("Tổng giá trị tồn kho: %,.0f VND".formatted(totalValue));
                writer.newLine();
                writer.write("Sản phẩm tồn kho cao nhất: %s (%s) - %,.0f VND".formatted(
                        maxValProduct.getName(), maxValProduct.getCode(), maxValProduct.inventoryValue()));
                writer.newLine();
            }
            System.out.println("=> Đã tạo báo cáo tổng hợp tại: " + reportPath);
        } catch (IOException e) {
            System.err.println("Lỗi ghi tệp báo cáo [" + reportPath + "]: " + e.getMessage());
        }
    }
}